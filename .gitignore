# Build
bin/
obj/
artifacts/
TestResults/

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo

# Local runtime data, anchored to the repository root so a source or test folder
# named `Sessions/` or `data/` elsewhere is never silently dropped from a commit.
# Private data placed outside the repo root is protected by the self-ignoring
# marker MeetCap writes into the data root (src/MeetCap.Persistence/Storage/DataRootMarker.cs).
/data/
/sessions/
*.db
*.db-shm
*.db-wal

# Secrets / local configuration
config.toml
.env
.env.*

# Audio
*.wav
*.flac
*.mp3
*.m4a
*.ogg

# OS
Thumbs.db
.DS_Store
