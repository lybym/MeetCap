<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MeetCap.Asr</RootNamespace>
    <AssemblyName>MeetCap.Asr</AssemblyName>
    <PackageId>MeetCap.Asr</PackageId>
    <Description>MeetCap-owned ASR subsystem: persistent job state machine driver, transcript assembly, and recording import.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetCap.Core\MeetCap.Core.csproj" />
    <!-- M4 (docs/ARCHITECTURE.md section 10): live transcription batches durable capture
         chunks, so this project consumes the recording artifact contract. The dependency
         points this way only; MeetCap.AudioPipeline must never reach the ASR stack
         (tests/MeetCap.AudioPipeline.Tests/CaptureIndependenceTests.cs). -->
    <ProjectReference Include="..\MeetCap.AudioPipeline\MeetCap.AudioPipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MeetCap.Asr.Tests" />
  </ItemGroup>

</Project>
