<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MeetCap.Cli</RootNamespace>
    <AssemblyName>meetcap</AssemblyName>
    <PackageId>MeetCap.Cli</PackageId>
    <Description>MeetCap command-line interface and composition root.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetCap.Core\MeetCap.Core.csproj" />
    <ProjectReference Include="..\MeetCap.Persistence\MeetCap.Persistence.csproj" />
    <ProjectReference Include="..\MeetCap.AudioPipeline\MeetCap.AudioPipeline.csproj" />
    <!-- Composition root only: no command handler may use NAudio types directly
         (docs/ARCHITECTURE.md section 3, docs/DEVELOPMENT.md section 4). -->
    <ProjectReference Include="..\MeetCap.WindowsAudio\MeetCap.WindowsAudio.csproj" />
    <ProjectReference Include="..\MeetCap.Asr\MeetCap.Asr.csproj" />
    <ProjectReference Include="..\MeetCap.Asr.Volcengine\MeetCap.Asr.Volcengine.csproj" />
    <!-- M6 / docs/ARCHITECTURE.md section 17: speaker registry semantics and the
         sherpa-onnx + 3D-Speaker identity provider. The CLI composition root joins
         them; domain code reaches neither. -->
    <ProjectReference Include="..\MeetCap.Speakers\MeetCap.Speakers.csproj" />
    <ProjectReference Include="..\MeetCap.Speakers.SherpaOnnx\MeetCap.Speakers.SherpaOnnx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- #9 / docs/ARCHITECTURE.md section 2: System.CommandLine for parsing and command hierarchy. -->
    <PackageReference Include="System.CommandLine" Version="2.0.5" />
    <!-- #9 / docs/ARCHITECTURE.md section 2: Serilog for structured logging. -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <!-- Bridges Serilog to the Microsoft.Extensions.Logging ILogger used by command handlers. -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MeetCap.Cli.Tests" />
  </ItemGroup>

</Project>
