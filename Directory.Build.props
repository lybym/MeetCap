<Project>
  <PropertyGroup>
    <Product>MeetCap</Product>
    <Authors>MeetCap</Authors>
    <Copyright>Copyright (c) MeetCap contributors. See LICENSE.</Copyright>
    <!-- Single source of truth for the assembly/package version. Every project
         in the solution inherits this; no .csproj sets its own Version. -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- MeetCap is a self-contained repository: pin package versions inline per project.
         This deliberately opts out of any ancestor central package management. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- M0 skeleton: rely on compiler warnings (CS*) enforced as errors.
         Code analyzers (CA*) can be tightened in a later quality milestone. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
</Project>
